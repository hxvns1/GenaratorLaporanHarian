{
  "entities": {
    "ActivityReport": {
      "title": "ActivityReport",
      "description": "Laporan Kegiatan harian Unit PKP-PK UPBU Kelas III Tanjung Api yang disinkronkan real-time untuk seluruh petugas.",
      "type": "object",
      "properties": {
        "unitScope": {
          "type": "string",
          "description": "Cakupan unit kerja resmi untuk isolasi kueri kolaboratif.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^pkp-pk-tanjung-api$"
        },
        "headerTitle": {
          "type": "string",
          "description": "Baris pertama kop laporan (bawaan: LAPORAN KEGIATAN).",
          "minLength": 1,
          "maxLength": 120
        },
        "headerUnit": {
          "type": "string",
          "description": "Baris kedua kop laporan (bawaan: UNIT PKP-PK).",
          "minLength": 1,
          "maxLength": 120
        },
        "headerLocation": {
          "type": "string",
          "description": "Baris ketiga kop laporan (bawaan: UPBU KELAS III TANJUNG API).",
          "minLength": 1,
          "maxLength": 160
        },
        "reportDateIso": {
          "type": "string",
          "description": "Tanggal kegiatan terstruktur format YYYY-MM-DD untuk penyortiran dan filter.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dayDateDisplay": {
          "type": "string",
          "description": "Teks Hari / Tanggal yang tercetak pada formulir (misal: Selasa 20 Oktober 2026).",
          "minLength": 1,
          "maxLength": 80
        },
        "place": {
          "type": "string",
          "description": "Lokasi pelaksanaan kegiatan (misal: Fire Station).",
          "minLength": 1,
          "maxLength": 160
        },
        "activityDescription": {
          "type": "string",
          "description": "Uraian kegiatan operasional atau pemeliharaan.",
          "minLength": 1,
          "maxLength": 2000
        },
        "documentationImage": {
          "type": "string",
          "description": "Data URL JPEG terkompresi dari satu gambar kolase dokumentasi (atau string kosong jika belum diunggah).",
          "maxLength": 600000
        },
        "reporterName": {
          "type": "string",
          "description": "Nama lengkap petugas yang membuat laporan.",
          "minLength": 1,
          "maxLength": 120
        },
        "reporterNip": {
          "type": "string",
          "description": "NIP petugas yang membuat laporan.",
          "maxLength": 60
        },
        "reporterSignature": {
          "type": "string",
          "description": "Data URL PNG tanda tangan pembuat laporan (atau string kosong).",
          "maxLength": 100000
        },
        "headTitle": {
          "type": "string",
          "description": "Jabatan pengetahui (bawaan: KEPALA UNIT PKP-PK).",
          "minLength": 1,
          "maxLength": 120
        },
        "headName": {
          "type": "string",
          "description": "Nama lengkap Kepala Unit PKP-PK.",
          "minLength": 1,
          "maxLength": 120
        },
        "headNip": {
          "type": "string",
          "description": "NIP Kepala Unit PKP-PK.",
          "maxLength": 60
        },
        "headSignature": {
          "type": "string",
          "description": "Data URL PNG tanda tangan Kepala Unit PKP-PK (atau string kosong).",
          "maxLength": 100000
        },
        "createdByUid": {
          "type": "string",
          "description": "UID pembuat awal dokumen (immutable).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "description": "Nama tampilan pembuat awal dokumen (immutable, tanpa email PII).",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID petugas yang terakhir memperbarui dokumen.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "description": "Nama tampilan petugas yang terakhir memperbarui dokumen.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Stempel waktu server saat laporan dibuat (Firestore Timestamp)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Stempel waktu server saat laporan terakhir diperbarui (Firestore Timestamp)."
        }
      },
      "required": [
        "unitScope",
        "headerTitle",
        "headerUnit",
        "headerLocation",
        "reportDateIso",
        "dayDateDisplay",
        "place",
        "activityDescription",
        "documentationImage",
        "reporterName",
        "reporterNip",
        "reporterSignature",
        "headTitle",
        "headName",
        "headNip",
        "headSignature",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "UnitSettings": {
      "title": "UnitSettings",
      "description": "Pengaturan bawaan bersama Unit PKP-PK UPBU Kelas III Tanjung Api (kop, Kepala Unit, preset lokasi).",
      "type": "object",
      "properties": {
        "unitScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^pkp-pk-tanjung-api$"
        },
        "headerTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "headerUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "headerLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "defaultHeadTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultHeadName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultHeadNip": {
          "type": "string",
          "maxLength": 60
        },
        "defaultHeadSignature": {
          "type": "string",
          "maxLength": 100000
        },
        "placePresets": {
          "type": "array",
          "description": "Daftar preset lokasi kegiatan (maksimal 15 item)."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "unitScope",
        "headerTitle",
        "headerUnit",
        "headerLocation",
        "defaultHeadTitle",
        "defaultHeadName",
        "defaultHeadNip",
        "defaultHeadSignature",
        "placePresets",
        "updatedByUid",
        "updatedByName",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pribadi petugas terisolasi khusus pemilik (menyimpan email PII dan identitas default pembuat laporan).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "defaultReporterName": {
          "type": "string",
          "maxLength": 120
        },
        "defaultReporterNip": {
          "type": "string",
          "maxLength": 60
        },
        "defaultReporterSignature": {
          "type": "string",
          "maxLength": 100000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "defaultReporterName",
        "defaultReporterNip",
        "defaultReporterSignature",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/ActivityReport"
      },
      "description": "Koleksi utama laporan kegiatan Unit PKP-PK UPBU Kelas III Tanjung Api."
    },
    "/unitSettings/{unitId}": {
      "schema": {
        "$ref": "#/entities/UnitSettings"
      },
      "description": "Konfigurasi bawaan bersama untuk kop, Kepala Unit, dan preset tempat."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Profil privat petugas (email PII terisolasi ketat khusus pemilik UID)."
    }
  }
}
