rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints (Verbatim sync with firebase-blueprint.json)
    function isValidActivityReport(data) {
      return data.keys().hasAll([
          'unitScope', 'headerTitle', 'headerUnit', 'headerLocation',
          'reportDateIso', 'dayDateDisplay', 'place', 'activityDescription',
          'documentationImage', 'reporterName', 'reporterNip', 'reporterSignature',
          'headTitle', 'headName', 'headNip', 'headSignature',
          'createdByUid', 'createdByName', 'updatedByUid', 'updatedByName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'unitScope', 'headerTitle', 'headerUnit', 'headerLocation',
          'reportDateIso', 'dayDateDisplay', 'place', 'activityDescription',
          'documentationImage', 'reporterName', 'reporterNip', 'reporterSignature',
          'headTitle', 'headName', 'headNip', 'headSignature',
          'createdByUid', 'createdByName', 'updatedByUid', 'updatedByName',
          'createdAt', 'updatedAt'
        ])
        && data.unitScope is string && data.unitScope.size() >= 1 && data.unitScope.size() <= 64 && data.unitScope.matches('^pkp-pk-tanjung-api$')
        && data.headerTitle is string && data.headerTitle.size() >= 1 && data.headerTitle.size() <= 120
        && data.headerUnit is string && data.headerUnit.size() >= 1 && data.headerUnit.size() <= 120
        && data.headerLocation is string && data.headerLocation.size() >= 1 && data.headerLocation.size() <= 160
        && data.reportDateIso is string && data.reportDateIso.size() == 10 && data.reportDateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dayDateDisplay is string && data.dayDateDisplay.size() >= 1 && data.dayDateDisplay.size() <= 80
        && data.place is string && data.place.size() >= 1 && data.place.size() <= 160
        && data.activityDescription is string && data.activityDescription.size() >= 1 && data.activityDescription.size() <= 2000
        && data.documentationImage is string && data.documentationImage.size() <= 600000
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 120
        && data.reporterNip is string && data.reporterNip.size() <= 60
        && data.reporterSignature is string && data.reporterSignature.size() <= 100000
        && data.headTitle is string && data.headTitle.size() >= 1 && data.headTitle.size() <= 120
        && data.headName is string && data.headName.size() >= 1 && data.headName.size() <= 120
        && data.headNip is string && data.headNip.size() <= 60
        && data.headSignature is string && data.headSignature.size() <= 100000
        && isValidId(data.createdByUid)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUnitSettings(data) {
      return data.keys().hasAll([
          'unitScope', 'headerTitle', 'headerUnit', 'headerLocation',
          'defaultHeadTitle', 'defaultHeadName', 'defaultHeadNip', 'defaultHeadSignature',
          'placePresets', 'updatedByUid', 'updatedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'unitScope', 'headerTitle', 'headerUnit', 'headerLocation',
          'defaultHeadTitle', 'defaultHeadName', 'defaultHeadNip', 'defaultHeadSignature',
          'placePresets', 'updatedByUid', 'updatedByName', 'updatedAt'
        ])
        && data.unitScope is string && data.unitScope.size() >= 1 && data.unitScope.size() <= 64 && data.unitScope.matches('^pkp-pk-tanjung-api$')
        && data.headerTitle is string && data.headerTitle.size() >= 1 && data.headerTitle.size() <= 120
        && data.headerUnit is string && data.headerUnit.size() >= 1 && data.headerUnit.size() <= 120
        && data.headerLocation is string && data.headerLocation.size() >= 1 && data.headerLocation.size() <= 160
        && data.defaultHeadTitle is string && data.defaultHeadTitle.size() >= 1 && data.defaultHeadTitle.size() <= 120
        && data.defaultHeadName is string && data.defaultHeadName.size() >= 1 && data.defaultHeadName.size() <= 120
        && data.defaultHeadNip is string && data.defaultHeadNip.size() <= 60
        && data.defaultHeadSignature is string && data.defaultHeadSignature.size() <= 100000
        && data.placePresets is list && data.placePresets.size() <= 15
        && (data.placePresets.size() == 0 || (data.placePresets[0] is string && data.placePresets[0].size() >= 1 && data.placePresets[0].size() <= 80))
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email',
          'defaultReporterName', 'defaultReporterNip', 'defaultReporterSignature',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email',
          'defaultReporterName', 'defaultReporterNip', 'defaultReporterSignature',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() <= 254
        && data.defaultReporterName is string && data.defaultReporterName.size() <= 120
        && data.defaultReporterNip is string && data.defaultReporterNip.size() <= 60
        && data.defaultReporterSignature is string && data.defaultReporterSignature.size() <= 100000
        && data.updatedAt is timestamp;
    }

    // 4. Shared Unit Activity Reports (/reports/{reportId})
    match /reports/{reportId} {
      allow get: if isVerifiedUser()
        && isValidId(reportId)
        && existing().unitScope == 'pkp-pk-tanjung-api';

      allow list: if isVerifiedUser()
        && resource.data.unitScope == 'pkp-pk-tanjung-api';

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidActivityReport(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(reportId)
        && isValidActivityReport(incoming())
        && existing().unitScope == 'pkp-pk-tanjung-api'
        && incoming().unitScope == existing().unitScope
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Full report content & documentation edit
          incoming().diff(existing()).affectedKeys().hasOnly([
            'headerTitle', 'headerUnit', 'headerLocation',
            'reportDateIso', 'dayDateDisplay', 'place', 'activityDescription',
            'documentationImage', 'reporterName', 'reporterNip', 'reporterSignature',
            'headTitle', 'headName', 'headNip', 'headSignature',
            'updatedByUid', 'updatedByName', 'updatedAt'
          ])
          ||
          // Action 2: Signatures & signatory metadata update only
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reporterName', 'reporterNip', 'reporterSignature',
            'headTitle', 'headName', 'headNip', 'headSignature',
            'updatedByUid', 'updatedByName', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(reportId)
        && existing().unitScope == 'pkp-pk-tanjung-api';
    }

    // 5. Shared Unit Defaults (/unitSettings/{unitId})
    match /unitSettings/{unitId} {
      allow get: if isVerifiedUser()
        && isValidId(unitId)
        && unitId == 'pkp-pk-tanjung-api';

      allow create: if isVerifiedUser()
        && isValidId(unitId)
        && unitId == 'pkp-pk-tanjung-api'
        && isValidUnitSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(unitId)
        && unitId == 'pkp-pk-tanjung-api'
        && isValidUnitSettings(incoming())
        && incoming().unitScope == existing().unitScope
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'headerTitle', 'headerUnit', 'headerLocation',
          'defaultHeadTitle', 'defaultHeadName', 'defaultHeadNip', 'defaultHeadSignature',
          'placePresets', 'updatedByUid', 'updatedByName', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // 6. Private Officer Profiles (/users/{userId}) - Strict PII Isolation
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email',
          'defaultReporterName', 'defaultReporterNip', 'defaultReporterSignature',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
